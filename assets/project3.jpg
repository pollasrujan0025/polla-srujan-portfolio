<svg xmlns="http://www.w3.org/2000/svg" width="600" height="360" viewBox="0 0 600 360">
  <defs>
    <linearGradient id="p3Grad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a" />
      <stop offset="50%" stop-color="#1e293b" />
      <stop offset="100%" stop-color="#0369a1" />
    </linearGradient>
    <linearGradient id="satGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" />
      <stop offset="100%" stop-color="#818cf8" />
    </linearGradient>
  </defs>
  <rect width="600" height="360" rx="16" fill="url(#p3Grad)" />
  <g transform="translate(180, 40)">
    <text x="120" y="40" fill="#38bdf8" font-family="system-ui, sans-serif" font-size="36" text-anchor="middle">🛰️</text>
    <polygon points="120,45 40,160 200,160" fill="url(#satGrad)" opacity="0.15" />
    <line x1="120" y1="45" x2="40" y2="160" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="4 3" />
    <line x1="120" y1="45" x2="200" y2="160" stroke="#38bdf8" stroke-width="1.5" stroke-dasharray="4 3" />
  </g>
  <rect x="0" y="280" width="600" height="80" fill="rgba(15, 23, 42, 0.85)" />
  <text x="30" y="315" fill="#f8fafc" font-family="system-ui, sans-serif" font-size="18" font-weight="700">AI Crop &amp; Moisture Stress Detection</text>
  <text x="30" y="340" fill="#94a3b8" font-family="system-ui, sans-serif" font-size="13">Remote-Sensing Satellite Analytics &amp; Irrigation Advisory</text>
</svg>
